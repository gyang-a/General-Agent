# Express server
SERVER_PORT=3000

# Comma-separated allowed origins. Leave empty in development if you want the server to allow all origins.
CORS_ORIGIN=http://localhost:5173,http://localhost:5174,http://localhost:5175

# Upload limits in bytes
UPLOAD_MAX_SIZE=10485760
AVATAR_MAX_SIZE=10485760

# Local auth
AUTH_USERNAME=your_username
AUTH_PASSWORD=your_password
AUTH_SECRET=kira_dev_secret
# 7 days in milliseconds
AUTH_TOKEN_TTL_MS=604800000

# ===== LangChain chat runtime =====
# Built-in chat providers are configured in server/modelRegistry.js.
# Put private API keys in server/modelSecrets.local.json, for example:
# {
#   "MiniMax-M2.7": { "apiKey": "your_api_key" }
# }
UPSTREAM_TIMEOUT_MS=120000
UPSTREAM_AUTH_MODE=bearer
UPSTREAM_TEMPERATURE=1
UPSTREAM_TOP_P=1
UPSTREAM_SYSTEM_PROMPT=You are a professional, concise, and accurate Chinese AI assistant. Reply in Chinese.

# Extra request headers for OpenAI-compatible providers.
# Example: {"x-api-key":"xxx","x-app-id":"demo"}
UPSTREAM_HEADERS_JSON=

# ===== MongoDB for app data, LangGraph checkpoints, and RAG =====
MONGODB_URI=mongodb://127.0.0.1:27017
MONGODB_DB_NAME=chat_app

# ===== Embeddings for RAG =====
EMBEDDING_API_URL=https://dashscope.aliyuncs.com/compatible-mode/v1/embeddings
EMBEDDING_API_KEY=
EMBEDDING_MODEL=text-embedding-v1
EMBEDDING_ENCODING_FORMAT=float
EMBEDDING_BATCH_SIZE=16

# ===== MongoDB vector search =====
MONGODB_VECTOR_SEARCH_ENABLED=false
MONGODB_VECTOR_INDEX_NAME=kb_chunks_vector_index
MONGODB_VECTOR_SEARCH_LIMIT=40
MONGODB_VECTOR_SEARCH_NUM_CANDIDATES=160

# Final context chunks injected into the model
RAG_CONTEXT_TOP_K=6

# Keyword recall fallback
RAG_KEYWORD_RECALL_LIMIT=80
RAG_KEYWORD_RECALL_MIN_HITS=1
RAG_KEYWORD_RECALL_MAX_TERMS=64

# RAG routing thresholds
RAG_ROUTE_MIN_CONFIDENCE=0.32
RAG_ROUTE_MIN_CONFIDENCE_TEXT=0.12
RAG_ROUTE_PINNED_BOOST_ENABLED=true
RAG_ROUTE_MIN_TOP_SCORE_TEXT=0.2
RAG_ROUTE_MIN_TOP_SCORE_SEMANTIC=0.24
RAG_ROUTE_MIN_TOP_SCORE_HYBRID=0.22

# Short-query guardrails
RAG_ROUTE_SHORT_QUERY_HARD_MAX_LEN=2
RAG_ROUTE_SHORT_QUERY_SOFT_MAX_LEN=4
RAG_ROUTE_SHORT_QUERY_MAX_TERMS=1

# Knowledge-base ingestion queue
KB_INGEST_CONCURRENCY=2
KB_INGEST_QUEUE_SIZE=80

# AMap MCP
AMAP_MAPS_API_KEY=

# Agent debug
AGENT_DEBUG_HISTORY=false
